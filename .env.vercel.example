# Isi di Vercel > Project > Settings > Environment Variables
APP_NAME=Zeflix
APP_KEY=            # php artisan key:generate --show
APP_URL=https://nama-proyek.vercel.app

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

SVOD_PRICE=1
ADMIN_EMAIL=admin@contoh.com
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Cloudflare R2 (penyimpanan video)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto

# Private Cloudflare R2 poster bucket
R2_POSTER_ACCESS_KEY_ID=
R2_POSTER_SECRET_ACCESS_KEY=
R2_POSTER_BUCKET=

# ==============================================================================
# ENVIRONMENT VARIABLES UNTUK VERCEL (ZEFLIX + AIVEN + MIDTRANS)
# Salin variabel ini ke Vercel: Project Dashboard > Settings > Environment Variables
# ==============================================================================

APP_NAME=Zeflix
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_URL=https://nama-project-anda.vercel.app

# ------------------------------------------------------------------------------
# DATABASE AIVEN (Pilih salah satu: MySQL atau PostgreSQL)
# ------------------------------------------------------------------------------
# 1. JIKA MENGGUNAKAN AIVEN MYSQL:
DB_CONNECTION=mysql
DB_HOST=mysql-xxxxxx.aivencloud.com
DB_PORT=xxxxx
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=password_dari_aiven
# Aiven MySQL mewajibkan SSL:
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# 2. JIKA MENGGUNAKAN AIVEN POSTGRESQL (Alternatif):
# DB_CONNECTION=pgsql
# DB_HOST=pg-xxxxxx.aivencloud.com
# DB_PORT=xxxxx
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=password_dari_aiven
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# TOKEN MIGRASI & SEEDER OTOMATIS DI VERCEL
# ------------------------------------------------------------------------------
# Setelah deploy, buka: https://nama-project.vercel.app/up/migrate?secret=TOKEN_INI&seed=true
DEPLOY_SECRET=bikin-token-rahasia-panjang-bebas123

# Akun Admin awal (dibuat saat seeder jalan):
ADMIN_EMAIL=admin@zeflix.com
ADMIN_PASSWORD=password_admin_minimal_12_karakter

# ------------------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_SIGNATURE_KEY=your_midtrans_signature_key_here
MIDTRANS_PRODUCTION=false
SVOD_PRICE=1

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 (Opsional: Video & Poster Storage)
# ------------------------------------------------------------------------------
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_REGION=auto
